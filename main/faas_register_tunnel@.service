[Unit]
Description=FAAS register Reverse Tunnel with Auto Certificate Renewal (%i)
After=network-online.target
Wants=network-online.target

# Allow more time before systemd gives up on restarts
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=%i
Environment=INSTANCE=%i
ExecStart=/usr/local/sbin/faas_register_tunnel.sh

# Restart policy tuned for port contention
Restart=always
RestartSec=60

# Capture logs clearly
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
